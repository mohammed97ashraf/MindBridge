# .env — MindBridge configuration
# Copy this file to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────
API_KEY=sk-your-key-here

# ── Optional — custom provider (leave blank to use OpenAI directly) ───────────
BASE_URL=https://your-proxy-or-router-url/v1
MODEL=gpt-4o-mini

# ── Fallback: standard OpenAI env var (used if API_KEY is not set) ────────────
OPENAI_API_KEY=sk-your-key-here
